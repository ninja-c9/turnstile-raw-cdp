# Cloudflare D1 Inbound Email Catch-All Configuration
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_D1_DB_ID=your_d1_database_uuid
CF_API_TOKEN=your_cloudflare_d1_read_token

# Optional Rotating Proxy Configuration for Split-Lane Register POST
ITERA_FALLBACK_PROXY=http://127.0.0.1:10582
VN_PROXY_ROTATE_URL=https://your-proxy-provider.example/api/rotate?key=YOUR_KEY

# Space-separated catch-all domains routed to Cloudflare Email Workers -> D1
DOMAINS=domain1.example.com domain2.example.com
